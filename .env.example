# =============================================
# .env — Environment Variables
# =============================================
# IMPORTANT: Never commit this file to GitHub!
# Copy this file, rename it to ".env", and fill in your real values.

# -----------------------------------------------
# Judge0 API Key (from RapidAPI)
# How to get it:
#   1. Go to https://rapidapi.com
#   2. Create a free account
#   3. Search for "Judge0 CE"
#   4. Click "Subscribe" → choose Free plan
#   5. Copy your API key from the "Header Parameters" section
# -----------------------------------------------
JUDGE0_API_KEY=your_rapidapi_key_here

# Judge0 API Host (don't change this)
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Port for the backend server (default: 3001)
PORT=3001
