{
  "name": "coding-platform-backend",
  "version": "1.0.0",
  "description": "NestJS backend for Coding Test Platform",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "dev:backend": "nest start --watch",
    "dev:frontend": "npm run dev --prefix youkt-frontend",
    "dev:recruiter": "npm run dev --prefix recruiter-frontend",
    "dev": "concurrently -k -c \"bgBlue.bold,bgMagenta.bold,bgGreen.bold\" \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:recruiter\""
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/node": "^20.3.1",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "concurrently": "^9.1.0"
  }
}
